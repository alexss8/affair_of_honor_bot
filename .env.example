# Токен вашего бота от @BotFather
BOT_TOKEN=вставьте_ваш_токен_сюда

# Ваш числовой Telegram ID для доступа к команде /status и алертам об ошибках
ADMIN_ID=

# Количество жизней у каждого бойца (по умолчанию 5)
DEFAULT_HP=5

# Количество мест в таблице лидеров /top
TOP_LIMIT=10

# Длительность дуэли в секундах; по истечении побеждает боец с большим запасом жизней
DUEL_TIMEOUT_SEC=300

# Сколько секунд действует вызов на дуэль, пока соперник не ответил
INVITE_TTL_SEC=300

# Имя файла базы данных SQLite и файла логов
DB_PATH=duels.db
LOG_FILE=bot.log
